# ---------------------------------------------------------------------------
# SyncAudio environment variables
# Copy this file to `.env` and fill in the values you need.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the Express + Socket.IO server listens on.
PORT=4000

# Public base URL of the app (used to build shareable room links + QR codes).
# In production this is your deployed domain, e.g. https://syncaudio.example.com
PUBLIC_APP_URL=http://localhost:5173

# Comma separated list of allowed browser origins for CORS + Socket.IO.
# In production set this to your real domain(s).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4000

# Max size of a single uploaded audio file, in megabytes.
MAX_UPLOAD_MB=80

# Max total audio bytes stored per room, in megabytes (temporary storage).
MAX_ROOM_STORAGE_MB=400

# How long a room with no connected participants is kept alive, in minutes.
ROOM_IDLE_TTL_MINUTES=30

# Grace period for the host to reconnect after a temporary disconnect (ms).
HOST_GRACE_MS=20000

# Directory used for temporary audio storage on disk.
UPLOAD_DIR=.syncaudio-uploads

# --- Supabase (optional) ----------------------------------------------------
# If both values are set, rooms/participants/tracks are also persisted to
# Supabase PostgreSQL. Leave blank to run fully in memory (default for MVP).
# The service-role key is ONLY read on the server and is never sent to clients.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Object storage (optional) ------------------------------------------------
# When set, uploaded audio is stored in S3-compatible object storage instead of
# local disk. Use any S3-compatible provider: AWS S3, Cloudflare R2, Backblaze
# B2, MinIO, etc. Leave blank to store uploads on local disk (default for dev).
# S3_ENDPOINT=https://abc123.r2.cloudflaress.com   # (R2) or https://s3.us-east-1.amazonaws.com
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Set to 1 if the bucket is public (no signed URLs needed).
S3_PUBLIC=0
